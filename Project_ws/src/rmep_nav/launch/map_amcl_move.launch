<launch>
    <param name="use_sim_time" value="false" />

    <!-- 1. Load the map（默认 changd.yaml，与 mission_config 闭环航点对齐） -->
    <arg name="map" default="new_field.yaml" />
    <include file="$(find rmep_nav)/launch/map_server.launch">
        <arg name="map" value="$(arg map)" />
    </include>

    <!-- 2. EKF: fuse wheel odometry + IMU (modern replacement for robot_pose_ekf) -->
    <include file="$(find rmep_nav)/launch/ekf.launch" />

    <!-- 3. AMCL：初值与 changd parking 对齐（车头朝 +Y） -->
    <arg name="init_x" default="3.6"/>
    <arg name="init_y" default="1.2"/>
    <arg name="init_a" default="1.57"/>
    <include file="$(find rmep_nav)/launch/amcl.launch">
        <arg name="init_x" value="$(arg init_x)"/>
        <arg name="init_y" value="$(arg init_y)"/>
        <arg name="init_a" value="$(arg init_a)"/>
    </include>

    <!-- 4. move_base: local_planner = teb | dwa | base -->
    <arg name="local_planner" default="teb" />
    <include file="$(find rmep_nav)/launch/move_base.launch">
        <arg name="local_planner" value="$(arg local_planner)" />
    </include>

    <!-- Optional: rviz with pre-configured navigation view -->
    <!-- <node pkg="rviz" type="rviz" name="rviz" args="-d $(find rmep_nav)/param/prams_rviz.rviz"/> -->
</launch>
