<launch>
    <!-- EKF localization using robot_localization (modern replacement for robot_pose_ekf).
         Fuses wheel odometry (/odom) and IMU (/imu_data) into /odom and odom->base_link TF.
    -->

    <!-- 轮速原始里程计；输出必须与输入分离，否则 EKF 自环 + TF_REPEATED_DATA -->
    <arg name="odom_topic" default="odom"/>
    <arg name="imu_topic" default="imu_data"/>
    <arg name="odom_pub_topic" default="odometry/filtered"/>
    <arg name="map_frame" default="map"/>
    <arg name="odom_frame" default="odom"/>
    <arg name="base_link_frame" default="base_link"/>
    <arg name="world_frame" default="odom"/>
    <arg name="publish_tf" default="true"/>
    <arg name="param_file" default="$(find rmep_nav)/param/ekf.yaml"/>

    <node pkg="robot_localization" type="ekf_localization_node" name="ekf_se" clear_params="true" output="screen">
        <remap from="odometry/filtered" to="$(arg odom_pub_topic)"/>
        <param name="odom0" value="$(arg odom_topic)"/>
        <param name="imu0" value="$(arg imu_topic)"/>
        <param name="map_frame" value="$(arg map_frame)"/>
        <param name="odom_frame" value="$(arg odom_frame)"/>
        <param name="base_link_frame" value="$(arg base_link_frame)"/>
        <param name="world_frame" value="$(arg world_frame)"/>
        <param name="publish_tf" value="$(arg publish_tf)"/>
        <rosparam command="load" file="$(arg param_file)"/>
    </node>
</launch>
